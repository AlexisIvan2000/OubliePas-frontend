# Copier vers .env pour le developpement. Aucune valeur secrete ici : tout ce
# qui est prefixe VITE_ est inscrit dans le bundle, et donc public.

# Adresse publique de l'API, absolue. Elle est lue au BUILD, pas a l'execution :
# la changer apres coup n'a aucun effet tant qu'on ne reconstruit pas. Absente,
# le build de production echoue plutot que de livrer une application qui
# interroge la machine du visiteur.
VITE_API_URL=http://localhost:8000
