# Copier vers .env pour le developpement. Aucune valeur secrete ici : tout ce
# qui est prefixe VITE_ est inscrit dans le bundle, et donc public.

# Adresse publique de l'API, absolue. Elle est lue au BUILD, pas a l'execution :
# la changer apres coup n'a aucun effet tant qu'on ne reconstruit pas.
#
# En local, tout marche sans ce fichier : le serveur de developpement et un
# build local se replient sur http://localhost:8000, le port par defaut de
# l'API. Sur une plateforme d'hebergement, en revanche, le build echoue si la
# variable manque, plutot que de livrer une application qui interrogerait la
# machine de chaque visiteur.
VITE_API_URL=http://localhost:8000
